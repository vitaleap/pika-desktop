{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pika",
  "version": "0.1.0",
  "identifier": "com.seepine.pika-desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:2420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pika",
        "width": 1200,
        "height": 800,
        "center": true,
        "visible": true
      },
      {
        "label": "update",
        "url": "update.html",
        "title": "软件更新",
        "width": 600,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Vitaleap",
    "copyright": "© 2026 Vitaleap",
    "category": "Productivity",
    "shortDescription": "Pika Desktop - AI Agent",
    "longDescription": "Pika 是一个开源桌面 Agent 应用，提供本地化的 AI 助手能力。",
    "homepage": "https://github.com/vitaleap/pika-desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGQUIxMzk0NzRDRDM0RDMKUldUVE5NMTBsQk9yZi9tYnQ0NnZsMzg0NThGVUpjOWlIM3VEZG1tYXNzaHRtMjRXL3gvbVVXOG0K",
      "endpoints": [
        "https://gh-proxy.com/https://github.com/vitaleap/pika-desktop/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/vitaleap/pika-desktop/releases/latest/download/latest.json",
        "https://github.com/vitaleap/pika-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
