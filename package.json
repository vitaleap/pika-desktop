{
  "name": "pika-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s check build-only",
    "build-only": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "run-p 'check:*'",
    "check:format": "prettier --check .",
    "check:type": "run-s gen-types type-check",
    "check:rust-fmt": "cargo fmt --all --manifest-path src-tauri/Cargo.toml --check",
    "check:rust-clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --no-deps --all-targets -- -D warnings",
    "check:rust-check": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets --locked",
    "gen-types": "jiti scripts/gen-types.ts",
    "type-check": "vue-tsc --noEmit",
    "lint": "run-p 'lint:*'",
    "lint:format": "prettier --write .",
    "lint:rust-fmt": "cargo fmt --all --manifest-path src-tauri/Cargo.toml",
    "lint-staged": "lint-staged",
    "release": "run-s check && commit-and-tag-version",
    "postinstall": "git-hooks --force"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.52.0",
    "marked": "^15.0.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.13",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@iconify/json": "^2.2.519",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "bun-git-hooks": "^0.3.3",
    "commit-and-tag-version": "^13.1.2",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.8",
    "sass": "^1.105.0",
    "typescript": "~6.0.3",
    "unocss": "^66.8.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.11"
  },
  "git-hooks": {
    "commit-msg": "bunx commitlint --edit \"$1\"",
    "pre-commit": "bun lint-staged"
  }
}
